# Copy to .env and fill in your provider's actual values.
# Existing environment variables take precedence over .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-id

# Optional. Defaults: ./examples for inputs, ./data for private results.
# Prefer absolute paths when configuring these directories.
# AI_LIBRARY_DIR=/path/to/your/books
# AI_OUTPUT_DIR=/path/to/your/learning-data
